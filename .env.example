DATABASE_URL=postgresql+asyncpg://nashr:nashr@localhost:5432/nashr
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./storage
GEMINI_API_KEY=
# Optional comma-separated image-model failover cascade.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Durable S3-compatible object storage is required before storage-backed Products can be published.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=
# Use path or virtual-host according to the provider's endpoint format.
OBJECT_STORAGE_URL_STYLE=path
# Single model, or a comma-separated failover cascade consumed identically by every layer.
GEMINI_MODEL=gemini-3.8-flash
# Book-map windows are bounded before Gemini sees the PDF. Lower this for unusually dense PDFs.
# GEMINI_BOOK_MAP_MAX_PAGES_PER_SECTION=64
# Max local maps merged per Gemini request; hierarchical rounds prevent a growing merge prompt.
# GEMINI_BOOK_MAP_MERGE_BATCH_SIZE=6
# Retry/failover policy (all optional; these are the defaults).
# GEMINI_RETRY_MAX_ATTEMPTS=2
# GEMINI_RETRY_BACKOFF_MIN_SECONDS=2
# GEMINI_RETRY_BACKOFF_MAX_SECONDS=10
# GEMINI_RETRY_BACKOFF_MULTIPLIER=2
# Total wall-clock budget for one full cascade walk (0 disables it).
# GEMINI_TOTAL_TIMEOUT_SECONDS=120
# The SDK retries are pinned to 1 so the cascade is the only retry authority.
# GEMINI_SDK_RETRY_ATTEMPTS=1
# GEMINI_HTTP_TIMEOUT_MS=90000
# LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESTINATION_ID=
